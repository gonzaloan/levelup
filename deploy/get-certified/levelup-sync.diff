+const TABLE_TYPE = /^\s+Type:\s*AWS::DynamoDB::Table\s*$/m;
+const SCALABLE_TARGET_TYPE = /^\s+Type:\s*AWS::ApplicationAutoScaling::ScalableTarget\s*$/m;
 

+  # One item per identity (id = identity id), holding a gzipped blob. No point-in-time
+  # recovery: every signed-in browser keeps a full copy and the sync is a union merge.
+  LevelupSyncTable:
+    Type: AWS::DynamoDB::Table
+    Condition: HasLevelupOrigin
+    DeletionPolicy: Retain
+    UpdateReplacePolicy: Retain
+    Properties:

+/* Tables named (`!GetAtt T.Arn` or `${T.Arn}`) by a role that browsers assume via an identity pool. */
+function browserTables(resources) {
+  const names = new Set();
+  Object.values(resources)
+    .filter((b) => ROLE_TYPE.test(b) && /cognito-identity\.amazonaws\.com/.test(section(b, "AssumeRolePolicyDocument", 6) || ""))
+    .forEach((role) => {
+      for (const m of role.matchAll(/!GetAtt\s+(\w+)\.Arn|\$\{(\w+)\.Arn\}/g)) names.add(m[1] || m[2]);
+    });
+  return [...names].filter((n) => resources[n] && TABLE_TYPE.test(resources[n]));
+}
+
+function capacityFaults(name, block, resources) {
+  const out = [];
+  if (value(block, "BillingMode") !== "PROVISIONED") {
+    out.push("BillingMode must be PROVISIONED: on-demand bills every request a signed-in browser sends");
+  }
+  const units = [...block.matchAll(/^\s+(Read|Write)CapacityUnits:\s*(.+?)\s*$/gm)];
+  if (!units.length) out.push("set ProvisionedThroughput with literal Read/WriteCapacityUnits");
+  units.forEach(([, kind, v]) => {
+    if (!/^\d+$/.test(v)) out.push(kind + "CapacityUnits must be a literal number, not " + v);
+    else if (Number(v) > MAX_BROWSER_CAPACITY) out.push(kind + "CapacityUnits " + v + " is over the ceiling of " + MAX_BROWSER_CAPACITY);
+  });
+  const scaled = Object.values(resources).some((b) => SCALABLE_TARGET_TYPE.test(b) &&
+    new RegExp("(!Ref\\s+" + name + "\\b|\\$\\{" + name + "\\}|table/" + name + "\\b)").test(b));
+  if (scaled) out.push("an autoscaling target lifts the capacity ceiling; remove it");
+  return out;
+}

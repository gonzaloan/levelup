+// Units per table, read and write each. 10 + 10 is about $5.50 a month at list price outside
+// the free tier; the levelup table uses 5 + 5. Raising this is a cost decision, made here.
+const MAX_BROWSER_CAPACITY = 10;
 
 const FUNCTION_TYPES = /^\s+Type:\s*AWS::(Serverless::Function|Lambda::Function)\s*$/m;
 const LOG_GROUP_TYPE = /^\s+Type:\s*AWS::Logs::LogGroup\s*$/m;

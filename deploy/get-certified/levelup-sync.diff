diff --git a/deploy/lambda/domain/apps.mjs b/deploy/lambda/domain/apps.mjs
new file mode 100644
index 0000000..8f39824
--- /dev/null
+++ b/deploy/lambda/domain/apps.mjs
@@ -0,0 +1,59 @@
+/* OTHER SITES' PROGRESS. A second site signs in with this pool and keeps one blob here, in the same
+ * table as the get-certified blob but under its own key, so neither can read or overwrite the other.
+ *
+ * The key is `<sub>#app:<app>`. A Cognito sub is a bare UUID and never holds "#", so no account's
+ * own row can collide with an app row. The row has `state` and `updatedAt` only: the leaderboard
+ * Scan keeps rows that have `scores`, so an app row can never appear on it.
+ *
+ * `APPS` is the allowlist. Adding a site is a code change plus a Cognito client in the template,
+ * never something a request can do: the app name in the path is checked against it.
+ *
+ * The store is an argument: `row(userId)`, `save(item)`, `remove(userId)`. */
+export const APPS = ["levelup"];
+
+// Under DynamoDB's 400 KB item limit, with room for the key and timestamp.
+export const MAX_APP_STATE_BYTES = 300 * 1024;
+
+const STATE_PATH = /\/apps\/([^/]+)\/state$/;
+
+export function isKnownApp(app) {
+  return APPS.includes(app);
+}
+
+export function appUserId(sub, app) {
+  return sub + "#app:" + app;
+}
+
+// { app, action: "get" | "put" } for the two state routes, else null. The app is not validated here.
+export function appStateRoute(method, path) {
+  const match = STATE_PATH.exec(path);
+  if (!match || (method !== "GET" && method !== "PUT")) return null;
+  return { app: match[1], action: method === "GET" ? "get" : "put" };
+}
+
+export function isPlainObject(value) {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export function exceedsLimit(value) {
+  return new TextEncoder().encode(JSON.stringify(value)).length > MAX_APP_STATE_BYTES;
+}
+
+export async function loadAppState({ sub, app }, store) {
+  const item = await store.row(appUserId(sub, app));
+  return (item && item.state) || {};
+}
+
+export async function saveAppState({ sub, app, state, now }, store) {
+  await store.save({ userId: appUserId(sub, app), state, updatedAt: now });
+}
+
+// null for an app with nothing saved, so an export tells "never used" from "used, empty".
+export async function exportAppStates(sub, store) {
+  const rows = await Promise.all(APPS.map((app) => store.row(appUserId(sub, app))));
+  return Object.fromEntries(APPS.map((app, i) => [app, (rows[i] && rows[i].state) || null]));
+}
+
+export async function removeAppStates(sub, store) {
+  await Promise.all(APPS.map((app) => store.remove(appUserId(sub, app))));
+}

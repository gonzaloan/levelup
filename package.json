{
  "name": "level-up",
  "version": "0.1.0",
  "private": true,
  "description": "AI Architect Field Guide — a bilingual (EN/ES) study guide and interview cheatsheet for Staff/Principal AI Architects.",
  "scripts": {
    "content": "node tools/build-content.mjs",
    "diagrams": "node tools/render-diagrams.mjs",
    "links": "node tools/check-links.mjs",
    "check": "node tools/check-concept.mjs",
    "predev": "node tools/build-content.mjs --allow-missing",
    "dev": "next dev",
    "prebuild": "node tools/build-content.mjs",
    "build": "next build",
    "start": "npx --yes serve out -l 3000 --no-port-switching",
    "serve:out": "npx --yes serve out -l 4180 --no-port-switching",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir src",
    "test": "vitest run",
    "e2e": "playwright test --workers=1",
    "verify": "node tools/build-content.mjs && tsc --noEmit && next lint --dir src && vitest run"
  },
  "dependencies": {
    "marked": "^14.1.4",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "mermaid": "^11.17.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}

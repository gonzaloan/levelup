{
  "name": "level-up",
  "version": "0.1.0",
  "private": true,
  "description": "The definitive guide to the part of engineering coding practice cannot teach — a bilingual, gamified path from Senior toward Staff/Principal.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out -l 3000 --no-port-switching",
    "serve:out": "npx --yes serve out -l 4180 --no-port-switching",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "content:check": "node tools/merge-lessons.cjs --check && node tools/check-trace.cjs",
    "verify": "npm run typecheck && npm run lint && npm run content:check && npm run test"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}

# Optional login + progress sync (same Cognito user pool as get-certified). Leave empty to keep the
# site local-only. Values come from the get-certified stack outputs; deploy/sync-config.sh writes them.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_IDENTITY_POOL_ID=
NEXT_PUBLIC_SYNC_TABLE=

# levelup Pro waitlist (stage 1): the external form's public URL (Tally, Google Forms). Empty: the
# /pro page says the list opens soon. See docs/business/stage-1.md.
NEXT_PUBLIC_PRO_FORM_URL=
